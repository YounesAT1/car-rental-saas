{
  "name": "car-rental-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src convex scripts *.json *.mjs *.ts *.yaml .env.example",
    "format:check": "prettier --check src convex scripts *.json *.mjs *.ts *.yaml",
    "typecheck": "next typegen && tsc --noEmit && tsc --project convex/tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm lint",
    "convex:dev": "convex dev",
    "convex:check": "convex dev --once",
    "smoke:providers": "node scripts/smoke-providers.mjs",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@clerk/localizations": "4.16.0",
    "@clerk/nextjs": "7.9.1",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.45.0",
    "framer-motion": "12.42.2",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
